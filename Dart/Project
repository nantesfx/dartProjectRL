void main() {
  print("=== SISTEMA SKYHORIZON AIRLINES ===\n");

  var p1 = Passageiro(nome: "Carlos Silva", cpf: "123.456.789-00");
  var canal = PlataformaVenda(codigoCanal: 101, nomeCanal: "App SkyHorizon");
  var fun1 = Atendente(nome: "Mariana Souza", matricula: "EMP987");

  print("--- 1. Passagem Padrão ---");
  var passagem1 = Passagem();
  passagem1.codigoLocalizador = ""; // Testando validação de erro
  passagem1.codigoLocalizador = "SKY12345";
  passagem1.passageiro = p1;
  passagem1.EmitirPassagem();
  print("Código cadastrado: ${passagem1.codigoLocalizador}\n");

  print("--- 2. Passagem Completa (Passagem.all) ---");
  var passagem2 = Passagem.all(
    "SKY67890",
    passageiro: p1,
    plataforma: canal,
    atendente: fun1,
    observacoes: "Passageiro preferência por assento na janela",
  );
  passagem2.AtualizarPassagem();
  print("Atendente: ${passagem2.atendente?.nome}\n");

  print("--- 3. Passagem Primeira Classe (VIP) ---");
  var passagemVip = PassagemPrimeiraClasse(
    "VIP99999",
    loungeAcesso: "Lounge Star Alliance VIP",
    passageiro: p1,
    plataforma: canal,
    atendente: fun1,
    observacoes: "Champagne de boas-vindas solicitado",
  );

  print("Lounge Acessível: ${passagemVip.loungeAcesso}");
  // Chamada polimórfica com reuso de Mixins
