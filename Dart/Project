
mixin LogAuditoria {
  void registrarLog(String acao, String detalhe) {
    print('[AUDIT ${DateTime.now().toIso8601String()}] [$acao] $detalhe');
  }
}

class Passageiro {
  final String id;
  final String nome;
  final String cpf;
  final String? email; // Opcional
  String? programaMilhas; // Opcional

  Passageiro({
    required this.id,
    required this.nome,
    required this.cpf,
    this.email,
    this.programaMilhas,
  });
}

abstract class Passagem with LogAuditoria {
  final String codigo;
  final String origem;
  final String destino;
  final double precoBase;
  final Passageiro passageiro;

  Passagem({
    required this.codigo,
    required this.origem,
    required this.destino,
    required this.precoBase,
    required this.passageiro,
  });

  double calcularPrecoFinal();

  void emitir() {
    registrarLog(
      'EMISSAO_BILHETE', 
      'Código: $codigo | Passageiro: ${passageiro.nome}'
    );
  }
}


class PassagemVIP extends Passagem {
  final double taxaServicoVIP; // Ex: 0.25 para 25%
  final String? codigoAcessoLounge;

  PassagemVIP({
    required super.codigo,
    required super.origem,
    required super.destino,
    required super.precoBase,
    required super.passageiro,
    this.taxaServicoVIP = 0.25,
    this.codigoAcessoLounge,
  }) : assert(precoBase > 0, 'O preço base deve ser maior que zero.');

  @override
  double calcularPrecoFinal() {
    return precoBase * (1 + taxaServicoVIP);
  }
}

class PlataformaVendas with LogAuditoria {
  final String idParceiro;
  final String nomeParceiro;
  final List<Passagem> _vendas = [];

  PlataformaVendas({required this.idParceiro, required this.nomeParceiro});

  void registrarVenda(Passagem passagem) {
    passagem.emitir();
    _vendas.add(passagem);
    registrarLog(
      'VENDA_PARCEIRA', 
      'Parceiro: $nomeParceiro | Total: R\$${passagem.calcularPrecoFinal().toStringAsFixed(2)}'
    );
  }
}

